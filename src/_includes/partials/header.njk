<header class="site-head">
  <div class="wrap site-head-in">
    <a class="brand" href="{{ prefix }}/" aria-label="Treasure Map{{ '（藏宝图）' if lang == 'zh' }}">
      <span class="brand-name">Treasure Map</span>
    </a>
    <nav class="site-nav" aria-label="{{ 'Main' if lang != 'zh' else '主导航' }}">
      <ul>
        <li class="nav-hide-sm"><a href="{{ prefix }}/#start"{% if pageKind == 'home' %} data-spy="start"{% endif %}>{{ t.nav.start }}</a></li>
        {%- if showcaseItems.length %}
        <li class="nav-sec"><a href="{{ prefix }}/showcase/"{% if section == 'showcase' %} aria-current="page"{% endif %}>{{ t.nav.showcase }}</a></li>
        {%- endif %}
        {%- if designItems.length %}
        <li class="nav-sec"><a href="{{ prefix }}/design/"{% if section == 'design' %} aria-current="page"{% endif %}>{{ t.nav.design }}</a></li>
        {%- endif %}
        <li><a class="nav-gh" href="{{ site.repo }}">{{ t.nav.github }}</a></li>
        <li><a class="nav-lang" href="{{ tr.url if tr else t.other.href }}" hreflang="{{ 'en' if lang == 'zh' else 'zh-CN' }}" lang="{{ 'en' if lang == 'zh' else 'zh-CN' }}">{{ t.other.label }}</a></li>
      </ul>
    </nav>
  </div>
  {%- if showcaseItems.length or designItems.length %}
  <nav class="subnav" aria-label="{{ 'Sections' if lang != 'zh' else '栏目' }}">
    <div class="wrap subnav-in">
      <a href="{{ prefix }}/#start">{{ t.nav.start }}</a>
      {%- if showcaseItems.length %}<a href="{{ prefix }}/showcase/"{% if section == 'showcase' %} aria-current="page"{% endif %}>{{ t.nav.showcase }}</a>{% endif %}
      {%- if designItems.length %}<a href="{{ prefix }}/design/"{% if section == 'design' %} aria-current="page"{% endif %}>{{ t.nav.design }}</a>{% endif %}
    </div>
  </nav>
  {%- endif %}
</header>
