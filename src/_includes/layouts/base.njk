{%- set t = i18n[lang or "en"] -%}
{%- set pageTitle = (title + " | Treasure Map") if title else t.meta.title -%}
{%- set pageDesc = description or t.meta.description -%}
{%- set prefix = "/zh" if lang == "zh" else "" -%}
{%- set blogItems = collections["blog_" + (lang or "en")] or [] -%}
{%- set showcaseItems = collections["showcase_" + (lang or "en")] or [] -%}
{%- set designItems = collections["design_" + (lang or "en")] or [] -%}
{%- set tr = collections.all | translationOf(translationKey, lang or "en") -%}
<!doctype html>
<html lang="{{ t.htmlLang }}" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{%- if tr %}
<link rel="alternate" hreflang="{{ 'zh-CN' if lang == 'zh' else 'en' }}" href="{{ site.url }}{{ page.url }}">
<link rel="alternate" hreflang="{{ 'en' if lang == 'zh' else 'zh-CN' }}" href="{{ site.url }}{{ tr.url }}">
{%- endif %}
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0b0b0b" media="(prefers-color-scheme: dark)">
<meta name="color-scheme" content="light dark">
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta property="og:type" content="{{ 'article' if pageKind == 'article' else 'website' }}">
<meta property="og:site_name" content="Treasure Map">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/og-{{ lang or 'en' }}.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content="{{ 'zh_CN' if lang == 'zh' else 'en_US' }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="preload" href="/assets/fonts/im-fell-english.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/site.css?v={{ build.stamp }}">
<script>
  (function (d) {
    d.classList.replace("no-js", "js");
    try {
      var t = localStorage.getItem("theme");
      if (t === "light" || t === "dark") {
        d.setAttribute("data-theme", t);
        document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) {
          m.content = t === "dark" ? "#0b0b0b" : "#ffffff";
        });
      }
    } catch (e) {}
  })(document.documentElement);
</script>
</head>
<body class="page-{{ pageKind or 'article' }}">
<a class="skip" href="#main">{{ t.skip }}</a>
{% include "partials/header.njk" %}
<main id="main" tabindex="-1">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
<script type="application/json" id="i18n">{{ { copy: t.copy, copied: t.copied, copyFailed: t.copyFailed, theme: t.theme } | json | safe }}</script>
<script src="/assets/js/site.js?v={{ build.stamp }}" defer></script>
</body>
</html>
